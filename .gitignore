# Dependencies
node_modules/

# Build output
dist/

# Local env file with secrets
.env
.env.local

# Netlify
.netlify/
# Regenerated by `netlify dev`, which boots a Deno runtime for Edge Functions. This project has
# none (netlify/functions/ are ordinary Node serverless functions), and nothing in the build reads
# this file — Vite builds the client, package-lock.json pins the deps. Local artifact only.
deno.lock

# OS
.DS_Store

# Per-course source material — quiz documents, homework problem screenshots, instructor
# answer keys, lecture notes. Copyrighted and/or answer-bearing, so never in the repo.
# Layout: source/<courseCode>/{quizzes,hw/HWn,lectures}/  e.g. source/phy215/hw/HW1/
# The figures the app actually serves live in public/homeworkFigures/<courseType>/HWn/
source/

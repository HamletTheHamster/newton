{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "classes": {
      "$classId": {
        "metadata": {
          ".validate": "newData.hasChildren(['name','courseType','active'])"
        },
        "roster": {},
        "studentPws": {},
        "submissions": {
          "$studentId": {
            "$submissionId": {
              ".validate": "!newData.exists() || $submissionId === newData.child('id').val()"
            }
          }
        },
        "submissionsArchive": {},
        "checkedSubs": {},
        "dueDates": {},
        "homeworkSettings": {},
        "modules": {},
        "moduleConfig": {},
        "pages": {},
        "uploads": {},
        "announcements": {},
        "announcementReads": {},
        "materialViews": {},
        "gradeCategories": {},
        "gradeOverrides": {},
        "assignmentCategories": {},
        "syllabus": {},
        "courseGuide": {},
        "quizDrafts": {},
        "hwDrafts": {},
        "hwAttempts": {},
        "hwProgress": {},
        "hwTelemetry": {},
        "studyPicks": {},
        "attendance": {},
        "blackboard": {}
      }
    },
    "settings": {},
    "bugReports": {},
    "_test": {}
  }
}
